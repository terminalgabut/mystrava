<div id="custom-console" class="fixed inset-0 bg-slate-950 z-[9999] hidden flex-col font-mono text-[10px]" style="display: none;">
    <div class="flex items-center justify-between p-4 border-b border-slate-800 bg-slate-900 shadow-xl">
        <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-blue-500 animate-pulse rounded-full"></div>
            <h2 class="text-blue-400 font-black tracking-widest uppercase">NGANGGUR_PRO // DEVTOOLS</h2>
        </div>
        <div class="flex gap-2">
            <button onclick="copyFullLog()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-md active:scale-95 transition-all font-bold">COPY ALL</button>
            <button onclick="clearLog()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-white rounded-md transition-all">CLEAR</button>
            <button onclick="toggleDebug()" class="px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white rounded-md italic font-bold">CLOSE</button>
        </div>
    </div>

<div id="log-container" class="flex-1 overflow-y-auto p-4 space-y-1 bg-slate-950 scrollbar-thin scrollbar-thumb-slate-800">
        </div>
</div>

<button onclick="toggleDebug()" class="fixed bottom-20 right-4 w-10 h-10 bg-slate-900/80 backdrop-blur-md rounded-full z-[9998] border border-white/10 flex items-center justify-center text-slate-500 hover:text-blue-400 hover:border-blue-500/50 transition-all shadow-2xl no-export">
    <i class="fa-solid fa-bug text-[14px]"></i>
</button>
