CREATE OR REPLACE FUNCTION refresh_daily_intelligence_by_date(target_date DATE)
RETURNS void AS $$
DECLARE
    -- Variabel Beban Latihan
    calc_acute FLOAT;
    calc_chronic FLOAT;
    calc_ratio FLOAT;
    calc_total_rpe INT; -- Diganti ke INT agar tidak ada desimal
    
    -- Variabel Data Hari Ini
    curr RECORD;

    -- Baseline Engine
    readiness INT := 85;      
    leg_score INT := 90;      
    status TEXT;
    reco TEXT := 'System Status Optimal.';
    
    -- Helper
    duration FLOAT;

BEGIN
    -- 1. HITUNG ACWR & RPE (SUM & ROUND)
    SELECT
        COALESCE(SUM(kilojoules) FILTER (WHERE start_date::DATE > target_date - INTERVAL '7 days' AND start_date::DATE <= target_date), 0) / 7.0,
        COALESCE(SUM(kilojoules) FILTER (WHERE start_date::DATE > target_date - INTERVAL '28 days' AND start_date::DATE <= target_date), 0) / 28.0
    INTO calc_acute, calc_chronic
    FROM public.activities;

    calc_ratio := CASE WHEN calc_chronic > 0 THEN ROUND((calc_acute / calc_chronic)::numeric, 2) ELSE 1.0 END;

    -- RPE di-SUM dan dipastikan menjadi INTEGER
    SELECT CEIL(COALESCE(SUM(user_rpe), 0))::INT INTO calc_total_rpe
    FROM public.activities WHERE start_date::DATE = target_date;

    -- 2. AMBIL DATA DARI DB
    SELECT * INTO curr FROM public.daily_intelligence WHERE check_in_date = target_date;

    IF curr.check_in_date IS NOT NULL THEN
        duration := COALESCE(curr.sleep_duration, 0);

        -- 3. LINEAR SCALING IMPACT (1-10)
        -- Menggunakan COALESCE agar jika input slider kosong tidak merusak hitungan (default ke netral)
        readiness := readiness + ((COALESCE(curr.cns_readiness, 7) - 7) * 5);
        readiness := readiness + ((COALESCE(curr.sleep_quality, 7) - 7) * 4);
        leg_score := leg_score + ((COALESCE(curr.soreness_level, 8) - 8) * 6);
        
        -- Fatigue dari SUM RPE (Baseline RPE 5)
        readiness := readiness + ((5 - calc_total_rpe) * 3);

        -- 4. DYNAMIC PENALTIES
        IF curr.cns_readiness < 5 AND calc_total_rpe > 7 THEN 
            readiness := readiness - 20; 
        END IF;
        
        IF curr.soreness_level < 5 AND curr.cns_readiness < 5 THEN 
            leg_score := leg_score - 25; 
            reco := 'CRITICAL: High Injury Risk. Focus on Mobility.';
        END IF;
        
        IF curr.sleep_quality < 5 AND calc_total_rpe > 7 THEN 
            readiness := readiness - 15; 
        END IF;

        -- 5. DYNAMIC BONUSES
        IF calc_total_rpe > 7 AND curr.cns_readiness > 7 THEN 
            readiness := readiness + 10; 
        END IF;
        
        IF curr.soreness_level < 5 AND calc_total_rpe < 4 AND calc_total_rpe > 0 THEN 
            leg_score := leg_score + 15; 
        END IF;

        -- 6. STANDAR AASM & ACWR
        IF duration > 0 AND duration < 6 THEN 
            readiness := readiness - 20; 
            leg_score := leg_score - 10; 
        END IF;

        IF calc_ratio > 1.5 THEN 
            leg_score := leg_score - 40; 
            readiness := readiness - 20; 
        ELSIF calc_ratio > 1.3 THEN 
            leg_score := leg_score - 20; 
        END IF;

        IF curr.is_active_recovery THEN 
            leg_score := leg_score + 10; 
            readiness := readiness + 5; 
        END IF;

        -- FINAL CLAMPING
        readiness := LEAST(GREATEST(readiness, 0), 100);
        leg_score := LEAST(GREATEST(leg_score, 0), 100);

        -- MAPPING STATUS
        IF readiness >= 80 THEN status := 'Optimal';
        ELSIF readiness >= 65 THEN status := 'Good';
        ELSIF readiness >= 45 THEN status := 'Fair';
        ELSE status := 'Rest Required'; 
        END IF;

        -- 7. UPDATE DATABASE
        UPDATE public.daily_intelligence SET
            acute_load = calc_acute,
            chronic_load = calc_chronic,
            acwr_ratio = calc_ratio,
            total_rpe = calc_total_rpe,
            readiness_score = readiness,
            leg_resilience = leg_score,
            readiness_status = status,
            recommendation = CASE WHEN readiness < 45 THEN 'CRITICAL: Total Rest Required.' ELSE reco END,
            last_updated = NOW()
        WHERE check_in_date = target_date;
    END IF;
END;
$$ LANGUAGE plpgsql;

