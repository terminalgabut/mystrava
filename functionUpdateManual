CREATE OR REPLACE FUNCTION refresh_daily_intelligence_by_date(target_date DATE)
RETURNS void AS $$
DECLARE
    calc_acute FLOAT;
    calc_chronic FLOAT;
    calc_ratio FLOAT;
    calc_total_rpe FLOAT;
    curr RECORD;
    readiness INT := 85;      
    leg_score INT := 90;      
    status TEXT;
    reco TEXT := 'System Status Optimal.';
    duration FLOAT;
BEGIN
    -- 1. HITUNG ACWR
    SELECT
        COALESCE(SUM(kilojoules) FILTER (WHERE start_date::DATE > target_date - INTERVAL '7 days' AND start_date::DATE <= target_date), 0) / 7.0,
        COALESCE(SUM(kilojoules) FILTER (WHERE start_date::DATE > target_date - INTERVAL '28 days' AND start_date::DATE <= target_date), 0) / 28.0
    INTO calc_acute, calc_chronic
    FROM public.activities;

    calc_ratio := CASE WHEN calc_chronic > 0 THEN ROUND((calc_acute / calc_chronic)::numeric, 2) ELSE 1.0 END;

    -- PAKAI SUM: Semakin banyak aktivitas, RPE semakin menumpuk
    SELECT COALESCE(SUM(user_rpe), 0) INTO calc_total_rpe
    FROM public.activities WHERE start_date::DATE = target_date;

    SELECT * INTO curr FROM public.daily_intelligence WHERE check_in_date = target_date;

    IF curr.check_in_date IS NOT NULL THEN
        duration := COALESCE(curr.sleep_duration, 0);

        -- 2. LINEAR SCALING (Maksimal dampak RPE dibatasi agar skor tidak minus ekstrim)
        readiness := readiness + ((curr.cns_readiness - 7) * 5);
        readiness := readiness + ((curr.sleep_quality - 7) * 4);
        leg_score := leg_score + ((curr.soreness_level - 8) * 6);
        
        -- Fatigue dari SUM RPE
        readiness := readiness + ((5 - calc_total_rpe) * 3);

        -- 3. DYNAMIC PENALTIES
        IF curr.cns_readiness < 5 AND calc_total_rpe > 7 THEN readiness := readiness - 20; END IF;
        IF curr.soreness_level < 5 AND curr.cns_readiness < 5 THEN leg_score := leg_score - 25; END IF;
        IF curr.sleep_quality < 5 AND calc_total_rpe > 7 THEN readiness := readiness - 15; END IF;

        -- 4. DYNAMIC BONUSES
        IF calc_total_rpe > 7 AND curr.cns_readiness > 7 THEN readiness := readiness + 10; END IF;
        IF curr.soreness_level < 5 AND calc_total_rpe < 4 AND calc_total_rpe > 0 THEN leg_score := leg_score + 15; END IF;

        -- 5. STANDAR AASM & ACWR
        IF duration > 0 AND duration < 6 THEN readiness := readiness - 20; leg_score := leg_score - 10; END IF;
        IF calc_ratio > 1.5 THEN leg_score := leg_score - 40; readiness := readiness - 20; 
        ELSIF calc_ratio > 1.3 THEN leg_score := leg_score - 20; END IF;

        IF curr.is_active_recovery THEN leg_score := leg_score + 10; readiness := readiness + 5; END IF;

        -- FINAL CLAMPING
        readiness := LEAST(GREATEST(readiness, 0), 100);
        leg_score := LEAST(GREATEST(leg_score, 0), 100);

        UPDATE public.daily_intelligence SET
            acute_load = calc_acute, chronic_load = calc_chronic, acwr_ratio = calc_ratio,
            total_rpe = calc_total_rpe, readiness_score = readiness, leg_resilience = leg_score,
            last_updated = NOW()
        WHERE check_in_date = target_date;
    END IF;
END;
$$ LANGUAGE plpgsql;


