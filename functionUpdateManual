-- Re-create Trigger Function
CREATE OR REPLACE FUNCTION trigger_refresh_intelligence()
RETURNS TRIGGER AS $$
BEGIN
    IF (TG_OP = 'DELETE') THEN
        PERFORM refresh_daily_intelligence_by_date(OLD.start_date::DATE);
    ELSE
        PERFORM refresh_daily_intelligence_by_date(NEW.start_date::DATE);
    END IF;
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

-- Apply Trigger to Activities Table
DROP TRIGGER IF EXISTS trg_auto_refresh_intelligence ON public.activities;
CREATE TRIGGER trg_auto_refresh_intelligence
AFTER INSERT OR UPDATE OR DELETE ON public.activities
FOR EACH ROW
EXECUTE FUNCTION trigger_refresh_intelligence();

