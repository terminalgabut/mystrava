    counter INT := 0;
BEGIN 
    -- Ambil semua tanggal yang ada di tabel daily_intelligence
    FOR record_item IN 
        SELECT check_in_date 
        FROM public.daily_intelligence 
        ORDER BY check_in_date DESC 
    LOOP 
        -- Jalankan fungsi refresh untuk setiap tanggal
        PERFORM refresh_daily_intelligence_by_date(record_item.check_in_date);
        counter := counter + 1;
    END LOOP; 
    
    RAISE NOTICE 'Backfill selesai. Total % hari telah diperbarui.', counter;
END $$;


