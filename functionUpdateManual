CREATE OR REPLACE FUNCTION refresh_daily_intelligence_by_date(target_date DATE)
RETURNS void AS $$
DECLARE
    -- Variabel Beban Latihan
    calc_acute FLOAT;
    calc_chronic FLOAT;
    calc_ratio FLOAT;
    calc_total_rpe FLOAT;
    
    -- Variabel Data Hari Ini
    curr RECORD;

    -- Baseline Engine (Sesuai fitnessEngine.js)
    readiness INT := 85;      
    leg_score INT := 90;      
    status TEXT;
    reco TEXT := 'System Status Optimal.';
    
    -- Helper
    duration FLOAT;

BEGIN
    -- 1. HITUNG BEBAN LATIHAN (ACWR)
    SELECT
        COALESCE(SUM(kilojoules) FILTER (WHERE start_date::DATE > target_date - INTERVAL '7 days' AND start_date::DATE <= target_date), 0) / 7.0,
        COALESCE(SUM(kilojoules) FILTER (WHERE start_date::DATE > target_date - INTERVAL '28 days' AND start_date::DATE <= target_date), 0) / 28.0
    INTO calc_acute, calc_chronic
    FROM public.activities;

    calc_ratio := CASE WHEN calc_chronic > 0 THEN ROUND((calc_acute / calc_chronic)::numeric, 2) ELSE 1.0 END;

    SELECT COALESCE(SUM(user_rpe), 0) INTO calc_total_rpe
    FROM public.activities WHERE start_date::DATE = target_date;

    -- 2. AMBIL DATA DARI DB
    SELECT * INTO curr FROM public.daily_intelligence WHERE check_in_date = target_date;

    IF curr.check_in_date IS NOT NULL THEN
        duration := COALESCE(curr.sleep_duration, 0);

        -- 3. MATRIX IMPACT 1-10 (LINEAR PENALTY)
        
        -- CNS Readiness
        IF curr.cns_readiness <= 3 THEN readiness := readiness - 35;
        ELSIF curr.cns_readiness <= 6 THEN readiness := readiness - 15;
        ELSIF curr.cns_readiness >= 9 THEN readiness := readiness + 10;
        END IF;

        -- Soreness (Impact ke Kaki)
        IF curr.soreness_level >= 9 THEN leg_score := leg_score - 50;
        ELSIF curr.soreness_level >= 7 THEN leg_score := leg_score - 35;
        ELSIF curr.soreness_level >= 4 THEN leg_score := leg_score - 15;
        END IF;

        -- Sleep Quality
        IF curr.sleep_quality <= 3 THEN readiness := readiness - 25;
        ELSIF curr.sleep_quality <= 6 THEN readiness := readiness - 10;
        ELSIF curr.sleep_quality >= 9 THEN readiness := readiness + 5;
        END IF;

        -- Total RPE (Daily Fatigue)
        IF calc_total_rpe >= 9 THEN readiness := readiness - 25; leg_score := leg_score - 15;
        ELSIF calc_total_rpe >= 7 THEN readiness := readiness - 15;
        ELSIF calc_total_rpe <= 3 AND calc_total_rpe > 0 THEN readiness := readiness + 5;
        END IF;

        -- 4. CROSS-PENALTY LOGIC (The "Cruel" Logic)
        
        -- A. Synergy of Exhaustion (Soreness 7+ & CNS 4-)
        IF curr.soreness_level >= 7 AND curr.cns_readiness <= 4 THEN
            leg_score := leg_score - 20;
            readiness := readiness - 10;
            reco := 'CRITICAL: High Injury Risk. Motor Control Impaired.';
        END IF;

        -- B. Recovery Blackout (Quality 4- & RPE 7+)
        IF curr.sleep_quality <= 4 AND calc_total_rpe >= 7 THEN
            readiness := readiness - 20;
        END IF;

        -- C. Neural Overshoot (ACWR 1.3+ & CNS 5-)
        IF calc_ratio > 1.3 AND curr.cns_readiness <= 5 THEN
            readiness := readiness - 15;
            leg_score := leg_score - 15;
        END IF;

        -- D. AASM Debt (Duration < 6 & Quality 4-)
        IF duration < 6 AND curr.sleep_quality <= 4 THEN
            readiness := readiness - 15;
        END IF;

        -- 5. STANDAR AASM & WORKLOAD ADDITIONAL
        IF duration > 0 AND duration < 6 THEN readiness := readiness - 20; END IF;
        IF curr.sleep_efficiency < 85 AND curr.sleep_efficiency > 0 THEN readiness := readiness - 15; END IF;
        
        IF calc_ratio > 1.5 THEN 
            leg_score := leg_score - 40; readiness := readiness - 20; 
        ELSIF calc_ratio > 1.3 THEN 
            leg_score := leg_score - 20; 
        END IF;

        -- 6. RECOVERY BONUS
        IF curr.is_active_recovery THEN
            leg_score := leg_score + 10;
            readiness := readiness + 5;
        END IF;

        -- FINAL CLAMPING
        readiness := LEAST(GREATEST(readiness, 0), 100);
        leg_score := LEAST(GREATEST(leg_score, 0), 100);

        -- MAPPING STATUS
        IF readiness >= 80 THEN status := 'Optimal';
        ELSIF readiness >= 65 THEN status := 'Good';
        ELSIF readiness >= 45 THEN status := 'Fair';
        ELSE status := 'Rest Required';
        END IF;

        -- RECOMMENDATION OVERRIDE
        IF readiness < 45 AND reco = 'System Status Optimal.' THEN
            reco := 'CRITICAL: Total Rest Required.';
        END IF;

        -- 7. UPDATE DATABASE
        UPDATE public.daily_intelligence SET
            acute_load = calc_acute,
            chronic_load = calc_chronic,
            acwr_ratio = calc_ratio,
            total_rpe = calc_total_rpe,
            readiness_score = readiness,
            leg_resilience = leg_score,
            readiness_status = status,
            recommendation = reco,
            last_updated = NOW()
        WHERE check_in_date = target_date;
    END IF;
END;
$$ LANGUAGE plpgsql;

SELECT refresh_daily_intelligence_by_date(check_in_date) 
FROM public.daily_intelligence;

trigger
on_activity_changed - trigger_refresh_intel - AFTER UPDATE, AFTER DELETE, AFTER INSERT - STATEMENT



